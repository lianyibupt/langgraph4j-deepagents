# Copy to .env and fill in the key locally. .env is ignored by Git.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# Local Markdown vault. Retrieval/preview is local; only explicitly selected files reach a model.
# The default window is the last year, using explicit document/path dates; undated imports are excluded.
# Example: PERSONAL_KNOWLEDGE_ROOT=/absolute/path/to/your/personal-notes
PERSONAL_KNOWLEDGE_ROOT=

# Local LM Studio (OpenAI-compatible). The base URL must stay on loopback: documents never
# leave this machine. The token is optional; leave it empty when LM Studio disables auth.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=
LMSTUDIO_MODEL=qwen3.8-9b-distill
LMSTUDIO_TIMEOUT_SECONDS=180
LMSTUDIO_MAX_TOKENS=2048
